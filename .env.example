# LLM Provider selection (nvidia or none)
LLM_PROVIDER=nvidia

# API key for the selected LLM provider (e.g. nvapi-...)
LLM_API_KEY=your_key_here
NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# Maximum number of pages to crawl during an audit
MAX_PAGES=100

# Maximum depth for web crawling traversal
MAX_DEPTH=3

# Timeout duration in seconds for HTTP requests
TIMEOUT_SECONDS=10
